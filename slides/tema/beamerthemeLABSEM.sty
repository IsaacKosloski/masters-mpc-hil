\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeLABSEM}[2026/09/26 v0.2 Tema LABSEM]
\RequirePackage{tikz}
\RequirePackage{labsem-marca}

\DeclareOptionBeamer{width}{\PassOptionsToPackage{width=#1}{beamerouterthemeLABSEM}}
\DeclareOptionBeamer{header}{\PassOptionsToPackage{header=#1}{beamerouterthemeLABSEM}}
\DeclareOptionBeamer{hidetitle}{\PassOptionsToPackage{hidetitle}{beamerouterthemeLABSEM}}
\DeclareOptionBeamer{hideinstitute}{\PassOptionsToPackage{hideinstitute}{beamerouterthemeLABSEM}}
\ProcessOptionsBeamer

\mode<presentation>
{
  \usecolortheme{LABSEM}
  \useinnertheme{LABSEM}
  \useoutertheme{LABSEM}
}
\mode<all>
